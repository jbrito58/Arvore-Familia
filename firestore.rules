rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Negar todo o acesso não explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTreeOwner(treeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/familyTrees/$(treeId)) &&
        get(/databases/$(database)/documents/familyTrees/$(treeId)).data.ownerId == request.auth.uid;
    }

    function canReadTree(treeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/familyTrees/$(treeId)) && (
          get(/databases/$(database)/documents/familyTrees/$(treeId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/familyTrees/$(treeId)).data.privacy == 'public'
        );
    }

    // Perfil de Usuários
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId);
    }

    // Árvores Genealógicas
    match /familyTrees/{treeId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.privacy == 'public'
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Pessoas / Familiares
    match /people/{personId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        canReadTree(resource.data.treeId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.createdBy == request.auth.uid ||
        isTreeOwner(request.resource.data.treeId)
      );
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isTreeOwner(resource.data.treeId)
      );
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isTreeOwner(resource.data.treeId)
      );
    }

    // Relacionamentos de Parentesco
    match /relationships/{relId} {
      allow read: if isSignedIn() && (
        (resource.data.createdBy != null && resource.data.createdBy == request.auth.uid) ||
        canReadTree(resource.data.treeId)
      );
      allow create: if isSignedIn() && (
        (request.resource.data.createdBy != null && request.resource.data.createdBy == request.auth.uid) ||
        isTreeOwner(request.resource.data.treeId)
      );
      allow update: if isSignedIn() && (
        (resource.data.createdBy != null && resource.data.createdBy == request.auth.uid) ||
        isTreeOwner(resource.data.treeId)
      );
      allow delete: if isSignedIn() && (
        (resource.data.createdBy != null && resource.data.createdBy == request.auth.uid) ||
        isTreeOwner(resource.data.treeId)
      );
    }

    // Eventos e Linha do Tempo
    match /events/{eventId} {
      allow read: if isSignedIn() && canReadTree(resource.data.treeId);
      allow create: if isSignedIn() && isTreeOwner(request.resource.data.treeId);
      allow update: if isSignedIn() && isTreeOwner(resource.data.treeId);
      allow delete: if isSignedIn() && isTreeOwner(resource.data.treeId);
    }

    // Mídias, Fotografias e Documentos
    match /media/{mediaId} {
      allow read: if isSignedIn() && canReadTree(resource.data.treeId);
      allow create: if isSignedIn() && isTreeOwner(request.resource.data.treeId);
      allow update: if isSignedIn() && isTreeOwner(resource.data.treeId);
      allow delete: if isSignedIn() && isTreeOwner(resource.data.treeId);
    }

    // Histórico de Alterações
    match /changeHistory/{historyId} {
      allow read: if isSignedIn() && canReadTree(resource.data.treeId);
      allow create: if isSignedIn() && isTreeOwner(request.resource.data.treeId);
      allow update, delete: if false;
    }
  }
}
